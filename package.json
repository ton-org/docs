{
  "name": "ton-docs",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next dev",
    "start:vercel": "NEXT_CONFIG=vercel next start",
    "build": "node scripts/pre-build.mjs && cross-env NODE_OPTIONS=--max_old_space_size=4096 next build && node scripts/post-build.mjs",
    "build:vercel": "node scripts/pre-build.mjs && NEXT_CONFIG=vercel next build",
    "build:cloudflare": "cross-env CF_PAGES=1 npm run build",
    "build:serve": "serve out",
    "check:types": "fumadocs-mdx && next typegen && tsc --noEmit",
    "check:openapi": "echo 'TODO: REPLACE mint openapi-check WITH NEW OpenAPI CHECKS'",
    "check:links": "echo 'TODO: REPLACE mint broken-links --check-snippets WITH NEW LINK CHECKS'",
    "check:redirects": "node scripts/check-redirects.mjs",
    "check:navigation": "node scripts/check-navigation.mjs",
    "check:fs": "echo 'Issue no. 1182 on GitHub:' && git config remote.origin.url",
    "check:fmt": "remark . -e mdx,md --no-stdout --quiet --frail && prettier --check .",
    "check:fmt:some": "remark --no-stdout --quiet --frail --silently-ignore",
    "check:spell": "cspell --no-progress --show-suggestions .",
    "check:all": "npm run check:openapi && npm run check:links && npm run check:redirects && npm run check:fs && npm run check:fmt && npm run check:spell",
    "fmt": "remark . -e mdx,md -o --silent && prettier --write --list-different .",
    "fmt:some": "remark -o --silent --silently-ignore",
    "spell": "cspell lint --no-progress --show-suggestions .",
    "spell:some": "cspell lint",
    "lint:all": "npm run check:all",
    "gen:tc2:overview": "python3 .github/scripts/generate-v2-api-table.py",
    "gen:tc3:overview": "python3 .github/scripts/generate-v3-api-table.py",
    "gen:mdx-for-openapi": "node .github/scripts/generate-openapi-pages.mjs",
    "gen:meta-schema": "node .github/scripts/generate-meta-schema.mjs",
    "gen:stats": "python3 .github/scripts/stats.py",
    "prepare": "husky",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@shikijs/transformers": "4.4.3",
    "@zbsearch/plugin-pt15": "4.0.0",
    "astring": "=1.9.0",
    "beautiful-mermaid": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "cnfast": "0.1.0",
    "cspell": "^10.1.1",
    "fumadocs-core": "16.14.5",
    "fumadocs-mdx": "15.3.0",
    "fumadocs-openapi": "11.2.4",
    "fumadocs-ui": "16.14.5",
    "husky": "^9.1.7",
    "katex": "^0.16.46",
    "lucide-react": "^1.17.0",
    "mermaid": "^11.15.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rehype-katex": "^7.0.1",
    "remark": "^15.0.1",
    "remark-cli": "^12.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "shiki": "4.4.3",
    "string-width": "=8.1.0",
    "unified-consistency": "=2.0.0",
    "unist-util-visit-parents": "^6.0.2",
    "zbsearch": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/config": "^0.5.6",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.14",
    "prettier": "^3.8.4",
    "react-medium-image-zoom": "^5.4.5",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.22",
    "npm": ">=11"
  },
  "overrides": {
    "@zbsearch/plugin-pt15": {
      "zbsearch": "4.0.0"
    }
  },
  "packageManager": "npm@11.11.1"
}
